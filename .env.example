# --- Database (Postgres via docker compose) ---
HARNESS_DATABASE_URL=postgresql+asyncpg://harness:harness@localhost:5432/harness

# --- LLM backend ---
# "gemini"     -> real model through Google ADK (Vertex AI or AI Studio)
# "rule_based" -> deterministic offline planner, no cloud calls (demo / Postman without credentials)
HARNESS_LLM_BACKEND=gemini
HARNESS_MODEL=gemini-2.5-flash
HARNESS_MODEL_TEMPERATURE=0.2
# Transport retries for 429/5xx from the model API (google-genai HttpRetryOptions)
HARNESS_MODEL_HTTP_RETRY_ATTEMPTS=3
HARNESS_MODEL_HTTP_RETRY_INITIAL_DELAY_S=1.0

# Vertex AI (read directly by google-genai / ADK)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Alternative: AI Studio API key (set GOOGLE_GENAI_USE_VERTEXAI=FALSE)
# GOOGLE_API_KEY=

# --- Execution limits ---
HARNESS_MAX_LLM_CALLS=12
HARNESS_MAX_TOOL_CALLS=10
HARNESS_MAX_IDENTICAL_TOOL_CALLS=2
HARNESS_RUN_TIME_BUDGET_S=60
HARNESS_MAX_MODEL_RETRIES=2

# --- Tool resilience ---
HARNESS_TOOL_TIMEOUT_S=5
HARNESS_TOOL_MAX_ATTEMPTS=3
HARNESS_TOOL_BACKOFF_BASE_S=0.5
# How many times the model is asked to reflect and retry after a tool error (ADK ReflectAndRetryToolPlugin)
HARNESS_TOOL_REFLECTION_RETRIES=1

# --- Mock tools ---
# HARNESS_DATA_DIR=./data
HARNESS_KB_TOP_K=3

# --- Mock fault injection (demo only), e.g. "get_service_status=transient,timeout;search_knowledge_base=fatal"
HARNESS_MOCK_FAULTS=

# --- Logging ---
HARNESS_LOG_LEVEL=INFO
# Long strings in trace payloads are truncated to this length
HARNESS_TRACE_MAX_STR_LEN=2000
